package rs.ac.bg.etf.pp1;

import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;

parser code {:

	boolean errorDetected;

	Logger log = Logger.getLogger(getClass());
   
   
    // slede redefinisani metodi za prijavu gresaka radi izmene teksta poruke
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	errorDetected = true;
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }


:}

init with {:
	errorDetected = false;
:}

scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null)
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}


terminal PROG, PRINT, RETURN, VOID, CONST, NEW, READ, BREAK, IF, ELSE, CONTINUE, DO, WHILE;
terminal PLUS, INC, ASSIGN, MINUS, DECR, MULT, DIV, MOD;
terminal EQUAL, NOTEQUAL, GREATER, GREATEREQUAL, LESS, LESSEQUAL, LOGAND, LOGOR;
terminal SEMI, COLON, COMMA, DOT, LPAREN, RPAREN, LBRACE, RBRACE, RSQBRACKET, LSQBRACKET;
terminal String IDENT;
terminal Integer NUMBER, BOOL;
terminal Character CHARACTER;
terminal FOR, SWITCH, CASE, LENGTH, QUESTION, ENUM;
terminal UNION, MAP;

nonterminal Program Program;
nonterminal ConstVarDeclEnumList ConstVarDeclEnumList;
nonterminal MethodDeclList MethodDeclList;
nonterminal ConstDeclList ConstDeclList;
nonterminal VarDeclList VarDeclList;
nonterminal ConstDecl ConstDecl;
nonterminal ConstDeclMore ConstDeclMore;
nonterminal Constant Constant;
nonterminal VarDecl VarDecl;
nonterminal VarDeclMore VarDeclMore;
nonterminal MethodSignature MethodSignature;
nonterminal MethodSignatureType MethodSignatureType;
nonterminal FormParsList FormParsList;
nonterminal FormParsMore FormParsMore;
nonterminal MethodDecl MethodDecl;
nonterminal Statement Statement;
nonterminal StatementList StatementList;
nonterminal DesignatorStatement DesignatorStatement;
nonterminal StatementIfElse StatementIfElse;
nonterminal StatementDoWhileCond StatementDoWhileCond;
nonterminal StatementDoWhileCondDesignatorSt StatementDoWhileCondDesignatorSt;
nonterminal ActPars ActPars;
nonterminal ActParsList ActParsList;
nonterminal ActParsMore ActParsMore;
nonterminal TermList TermList;
nonterminal SimpleDesignator SimpleDesignator;
nonterminal MethodDeclVarDeclList MethodDeclVarDeclList;
nonterminal FormPars FormPars;
nonterminal Label Label;
nonterminal Assignop Assignop;
nonterminal Relop Relop;
nonterminal Addop Addop;
nonterminal Mulop Mulop;
nonterminal ProgramName ProgramName;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Factor, FactorMore, Term, ExprAddopTerms;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Expr;
nonterminal rs.etf.pp1.symboltable.concepts.Struct FactorActPars, StatementPrintNumConst;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Condition;
nonterminal rs.etf.pp1.symboltable.concepts.Struct CondTerm, CondTermMore, CondFact, CondFactMore;
nonterminal	rs.etf.pp1.symboltable.concepts.Obj Designator, DesignatorName, MethodRetAndName;
nonterminal rs.etf.pp1.symboltable.concepts.Struct StatementReturnExpr;
nonterminal rs.etf.pp1.symboltable.concepts.Struct Type;
nonterminal DoNonterm DoNonterm;
nonterminal ActParsListBegin ActParsListBegin;
nonterminal Else Else;
nonterminal WhileNonTerm WhileNonTerm;

nonterminal EnumBegin EnumBegin;
nonterminal EnumDecl EnumDecl;
nonterminal EnumConst EnumConst;
nonterminal EnumNumConst EnumNumConst;
nonterminal EnumConstMore EnumConstMore;
nonterminal SwitchCaseList SwitchCaseList;
nonterminal SwitchNonTerm SwitchNonTerm;
nonterminal ForCondition ForCondition;
nonterminal ForNonTerm ForNonTerm;
nonterminal	rs.etf.pp1.symboltable.concepts.Obj DesignatorSuffix;
nonterminal rs.etf.pp1.symboltable.concepts.Struct NonTernaryExpr;
nonterminal TernaryColon TernaryColon;
nonterminal SwitchCaseNumber SwitchCaseNumber;
nonterminal SwitchCaseColon SwitchCaseColon;
nonterminal SwitchEndStatement SwitchEndStatement;
nonterminal ForDesignatorStatement_1 ForDesignatorStatement_1;
nonterminal ForDesignatorStatement_2 ForDesignatorStatement_2;


precedence left ELSE;


Program ::= (Program) PROG ProgramName:P1 ConstVarDeclEnumList:C2 LBRACE MethodDeclList:M3 RBRACE {: RESULT=new Program(P1, C2, M3); RESULT.setLine(P1left); :};

ProgramName ::= (ProgramName) IDENT:I1 {: RESULT=new ProgramName(I1); RESULT.setLine(I1left); :};

ConstVarDeclEnumList ::= (ConstVarDeclEnumList_Const) ConstVarDeclEnumList:C1 ConstDeclList:C2 {: RESULT=new ConstVarDeclEnumList_Const(C1, C2); RESULT.setLine(C1left); :}
						 |
						 (ConstVarDeclEnumList_Var) ConstVarDeclEnumList:C1 VarDeclList:V2 {: RESULT=new ConstVarDeclEnumList_Var(C1, V2); RESULT.setLine(C1left); :}
						 |
						 (ConstVarDeclEnumList_Enum) ConstVarDeclEnumList:C1 EnumDecl:E2 {: RESULT=new ConstVarDeclEnumList_Enum(C1, E2); RESULT.setLine(C1left); :}
						 |
						 (ConstVarDeclEnumList_Epsilon) {: RESULT=new ConstVarDeclEnumList_Epsilon(); :} /*epsilon*/
						 ;

ConstDeclList ::= (ConstDeclList) CONST Type:T1 ConstDecl:C2 ConstDeclMore:C3 SEMI {: RESULT=new ConstDeclList(T1, C2, C3); RESULT.setLine(T1left); :};

ConstDecl ::= (ConstDecl) IDENT:I1 ASSIGN Constant:C2 {: RESULT=new ConstDecl(I1, C2); RESULT.setLine(I1left); :};

ConstDeclMore ::= (ConstDeclMore_Comma) COMMA ConstDecl:C1 ConstDeclMore:C2 {: RESULT=new ConstDeclMore_Comma(C1, C2); RESULT.setLine(C1left); :}
				  |
				  (ConstDeclMore_Epsilon) {: RESULT=new ConstDeclMore_Epsilon(); :} /* epsilon */
				  ;

Constant ::= (Constant_Number) NUMBER:N1 {: RESULT=new Constant_Number(N1); RESULT.setLine(N1left); :}
			 |
			 (Constant_Character) CHARACTER:C1 {: RESULT=new Constant_Character(C1); RESULT.setLine(C1left); :}
			 |
			 (Constant_Bool) BOOL:B1 {: RESULT=new Constant_Bool(B1); RESULT.setLine(B1left); :}
			 ;

Type ::= (Type) IDENT:I1 {: RESULT=new Type(I1); RESULT.setLine(I1left); :};

VarDecl ::= (VarDecl_Regular) IDENT:I1 {: RESULT=new VarDecl_Regular(I1); RESULT.setLine(I1left); :}
			|
			(VarDecl_Array) IDENT:I1 LSQBRACKET RSQBRACKET {: RESULT=new VarDecl_Array(I1); RESULT.setLine(I1left); :}
			;

VarDeclList ::= (VarDeclList) Type:T1 VarDecl:V2 VarDeclMore:V3 SEMI {: RESULT=new VarDeclList(T1, V2, V3); RESULT.setLine(T1left); :};
 			 
VarDeclMore ::= (VarDeclMore_Comma) COMMA VarDecl:V1 VarDeclMore:V2 {: RESULT=new VarDeclMore_Comma(V1, V2); RESULT.setLine(V1left); :}
				|
				(VarDeclMore_Semi) {: RESULT=new VarDeclMore_Semi(); :} /* Epsilon */
				;
				
EnumDecl ::= (EnumDecl) ENUM EnumBegin:E1 LBRACE EnumConst:E2 EnumConstMore:E3 RBRACE {: RESULT=new EnumDecl(E1, E2, E3); RESULT.setLine(E1left); :};

EnumBegin ::= (EnumBegin) IDENT:I1 {: RESULT=new EnumBegin(I1); RESULT.setLine(I1left); :};

EnumConst ::= (EnumConst) IDENT:I1 EnumNumConst:E2 {: RESULT=new EnumConst(I1, E2); RESULT.setLine(I1left); :};
				 
EnumConstMore ::= (EnumConstMore_Yes) COMMA EnumConst:E1 EnumConstMore:E2 {: RESULT=new EnumConstMore_Yes(E1, E2); RESULT.setLine(E1left); :}
				  |
				  (EnumConstMore_Epsilon) {: RESULT=new EnumConstMore_Epsilon(); :} /* Epsilon */
				  ;

EnumNumConst ::= (EnumNumConst_Yes) ASSIGN NUMBER:N1 {: RESULT=new EnumNumConst_Yes(N1); RESULT.setLine(N1left); :}
				 |
				 (EnumNumConst_Epsilon) {: RESULT=new EnumNumConst_Epsilon(); :} /* Epsilon */
				 ;

MethodSignature ::= (MethodSignature) MethodRetAndName:M1 LPAREN FormParsList:F2 RPAREN {: RESULT=new MethodSignature(M1, F2); RESULT.setLine(M1left); :};

MethodRetAndName ::= (MethodRetAndName_Type) Type:T1 IDENT:I2 {: RESULT=new MethodRetAndName_Type(T1, I2); RESULT.setLine(T1left); :}
					 |
					 (MethodRetAndName_Void) VOID IDENT:I1 {: RESULT=new MethodRetAndName_Void(I1); RESULT.setLine(I1left); :}
					 ;

FormPars ::= (FormPars_Regular) Type:T1 IDENT:I2 {: RESULT=new FormPars_Regular(T1, I2); RESULT.setLine(T1left); :}
			 |
			 (FormPars_Array) Type:T1 IDENT:I2 LSQBRACKET RSQBRACKET {: RESULT=new FormPars_Array(T1, I2); RESULT.setLine(T1left); :}
			 ;

FormParsList ::= (FormParsList_Yes) FormPars:F1 FormParsMore:F2 {: RESULT=new FormParsList_Yes(F1, F2); RESULT.setLine(F1left); :}
				 |
				 (FormParsList_Epsilon) {: RESULT=new FormParsList_Epsilon(); :} /* Epsilon */
				 ;

FormParsMore ::= (FormParsMore_Comma) COMMA FormPars:F1 FormParsMore:F2 {: RESULT=new FormParsMore_Comma(F1, F2); RESULT.setLine(F1left); :}
				 |
				 (FormParsMore_Epsilon) {: RESULT=new FormParsMore_Epsilon(); :} /* Epsilon */
				 ;
				 
MethodDecl ::= (MethodDecl) MethodSignature:M1 MethodDeclVarDeclList:M2 LBRACE StatementList:S3 RBRACE {: RESULT=new MethodDecl(M1, M2, S3); RESULT.setLine(M1left); :};

MethodDeclVarDeclList ::= (MethodDeclVarDeclList_Yes) VarDeclList:V1 MethodDeclVarDeclList:M2 {: RESULT=new MethodDeclVarDeclList_Yes(V1, M2); RESULT.setLine(V1left); :}
						  |
						  (MethodDeclVarDeclList_Epsilon) {: RESULT=new MethodDeclVarDeclList_Epsilon(); :} /* Epsilon */
						  ;

MethodDeclList ::= (MethodDeclList_More) MethodDecl:M1 MethodDeclList:M2 {: RESULT=new MethodDeclList_More(M1, M2); RESULT.setLine(M1left); :}
				   |
				   (MethodDeclList_Epsilon) {: RESULT=new MethodDeclList_Epsilon(); :} /* Epsilon */
				   ;

StatementList ::= (StatementList_More) Statement:S1 StatementList:S2 {: RESULT=new StatementList_More(S1, S2); RESULT.setLine(S1left); :}
				  |
				  (StatementList_Epsilon) {: RESULT=new StatementList_Epsilon(); :} /* Epsilon */
				  ;

Statement ::= (Statement_Designator) DesignatorStatement:D1 SEMI {: RESULT=new Statement_Designator(D1); RESULT.setLine(D1left); :}
			  |
			  (Statement_If) IF LPAREN Condition:C1 RPAREN Statement:S2 StatementIfElse:S3 {: RESULT=new Statement_If(C1, S2, S3); RESULT.setLine(C1left); :}
			  |
			  (Statement_Break) BREAK SEMI {: RESULT=new Statement_Break(); :}
			  |
			  (Statement_Continue) CONTINUE SEMI {: RESULT=new Statement_Continue(); :}
			  |
			  (Statement_Return) RETURN StatementReturnExpr:S1 SEMI {: RESULT=new Statement_Return(S1); RESULT.setLine(S1left); :}
			  |
			  (Statement_Read) READ LPAREN Designator:D1 RPAREN SEMI {: RESULT=new Statement_Read(D1); RESULT.setLine(D1left); :}
			  |
			  (Statement_Print) PRINT LPAREN Expr:E1 StatementPrintNumConst:S2 RPAREN SEMI {: RESULT=new Statement_Print(E1, S2); RESULT.setLine(E1left); :}
			  |
			  (Statement_DoWhile) DoNonterm:D1 Statement:S2 WhileNonTerm:W3 LPAREN StatementDoWhileCond:S4 RPAREN SEMI {: RESULT=new Statement_DoWhile(D1, S2, W3, S4); RESULT.setLine(D1left); :}
			  |
			  (Statement_Switch) SwitchNonTerm:S1 LPAREN Expr:E2 RPAREN LBRACE SwitchCaseList:S3 RBRACE {: RESULT=new Statement_Switch(S1, E2, S3); RESULT.setLine(S1left); :}
			  |
			  (Statement_For) ForNonTerm:F1 LPAREN ForDesignatorStatement_1:F2 SEMI ForCondition:F3 SEMI ForDesignatorStatement_2:F4 RPAREN Statement:S5 {: RESULT=new Statement_For(F1, F2, F3, F4, S5); RESULT.setLine(F1left); :}
			  |
			  (Statement_List) LBRACE StatementList:S1 RBRACE {: RESULT=new Statement_List(S1); RESULT.setLine(S1left); :}
			  ;
			  
SwitchNonTerm ::= (SwitchNonTerm) SWITCH {: RESULT=new SwitchNonTerm(); :};
			  
SwitchCaseList ::= (SwitchCaseList_More) CASE SwitchCaseNumber:S1 SwitchCaseColon:S2 StatementList:S3 SwitchEndStatement:S4 SwitchCaseList:S5 {: RESULT=new SwitchCaseList_More(S1, S2, S3, S4, S5); RESULT.setLine(S1left); :}
				   |
				   (SwitchCaseList_Epsilon) {: RESULT=new SwitchCaseList_Epsilon(); :} /* Epsilon */
				   ;
				   
SwitchCaseNumber ::= (SwitchCaseNumber) NUMBER:N1 {: RESULT=new SwitchCaseNumber(N1); RESULT.setLine(N1left); :};

SwitchCaseColon ::= (SwitchCaseColon) COLON {: RESULT=new SwitchCaseColon(); :};

SwitchEndStatement ::= (SwitchEndStatement) {: RESULT=new SwitchEndStatement(); :} /* Epsilon */;
				   
ForDesignatorStatement_1 ::= (ForDesignatorStatement_1_Yes) DesignatorStatement:D1 {: RESULT=new ForDesignatorStatement_1_Yes(D1); RESULT.setLine(D1left); :}
						     |
						     (ForDesignatorStatement_1_Epsilon) {: RESULT=new ForDesignatorStatement_1_Epsilon(); :} /* Epsilon */
						     ;

ForDesignatorStatement_2 ::= (ForDesignatorStatement_2_Yes) DesignatorStatement:D1 {: RESULT=new ForDesignatorStatement_2_Yes(D1); RESULT.setLine(D1left); :}
						     |
						     (ForDesignatorStatement_2_Epsilon) {: RESULT=new ForDesignatorStatement_2_Epsilon(); :} /* Epsilon */
						     ;

ForCondition ::= (ForCondition_Yes) Condition:C1 {: RESULT=new ForCondition_Yes(C1); RESULT.setLine(C1left); :}
				 |
				 (ForCondition_Epsilon) {: RESULT=new ForCondition_Epsilon(); :} /* Epsilon */
				 ;
				 
ForNonTerm ::= (ForNonTerm) FOR {: RESULT=new ForNonTerm(); :};

DoNonterm ::= (DoNonterm) DO {: RESULT=new DoNonterm(); :};

WhileNonTerm ::= (WhileNonTerm) WHILE {: RESULT=new WhileNonTerm(); :};
			  
StatementIfElse ::= (Statement_IfElse_Yes) Else:E1 Statement:S2 {: RESULT=new Statement_IfElse_Yes(E1, S2); RESULT.setLine(E1left); :}
					 |
					 (Statement_IfElse_Epsilon) {: RESULT=new Statement_IfElse_Epsilon(); :} /* Epsilon */
					 ;

Else ::= (Else) ELSE {: RESULT=new Else(); :};

StatementReturnExpr ::= (Statement_ReturnExpr_Yes) Expr:E1 {: RESULT=new Statement_ReturnExpr_Yes(E1); RESULT.setLine(E1left); :}
						 |
						 (Statement_ReturnExpr_Epsilon) {: RESULT=new Statement_ReturnExpr_Epsilon(); :} /* Epsilon */
						 ;
						 
StatementPrintNumConst ::= (Statement_PrintNumConst_Yes) COMMA NUMBER:N1 {: RESULT=new Statement_PrintNumConst_Yes(N1); RESULT.setLine(N1left); :}
							|
							(Statement_PrintNumConst_Epsilon) {: RESULT=new Statement_PrintNumConst_Epsilon(); :} /* Epsilon */
							;				 
						 
StatementDoWhileCond ::= (Statement_DoWhileCond_Yes) Condition:C1 StatementDoWhileCondDesignatorSt:S2 {: RESULT=new Statement_DoWhileCond_Yes(C1, S2); RESULT.setLine(C1left); :}
						  |
						  (Statement_DoWhileCond_Epsilon) {: RESULT=new Statement_DoWhileCond_Epsilon(); :} /* Epsilon */
						  ;
						  
StatementDoWhileCondDesignatorSt ::= (Statement_DoWhileCondDesignatorSt_Yes) COMMA DesignatorStatement:D1 {: RESULT=new Statement_DoWhileCondDesignatorSt_Yes(D1); RESULT.setLine(D1left); :}
									  |
									  (Statement_DoWhileCondDesignatorSt_Epsilon) {: RESULT=new Statement_DoWhileCondDesignatorSt_Epsilon(); :} /* Epsilon */
									  ;

DesignatorStatement ::= (DesignatorStatement_Assign) Designator:D1 Assignop:A2 Expr:E3 {: RESULT=new DesignatorStatement_Assign(D1, A2, E3); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_ActPars) Designator:D1 LPAREN ActParsList:A2 RPAREN {: RESULT=new DesignatorStatement_ActPars(D1, A2); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_Inc) Designator:D1 INC {: RESULT=new DesignatorStatement_Inc(D1); RESULT.setLine(D1left); :}
						|
						(DesignatorStatement_Dec) Designator:D1 DECR {: RESULT=new DesignatorStatement_Dec(D1); RESULT.setLine(D1left); :}
						;		 

ActPars ::= (ActPars) Expr:E1 ActParsMore:A2 {: RESULT=new ActPars(E1, A2); RESULT.setLine(E1left); :};

ActParsMore ::= (ActParsMore_Yes) COMMA ActPars:A1 {: RESULT=new ActParsMore_Yes(A1); RESULT.setLine(A1left); :}
				|
				(ActParsMore_Epsilon) {: RESULT=new ActParsMore_Epsilon(); :} /* Epsilon */
				;
					 
ActParsList ::= (ActParsList_Yes) ActParsListBegin:A1 ActPars:A2 {: RESULT=new ActParsList_Yes(A1, A2); RESULT.setLine(A1left); :}
				|
				(ActParsList_Epsilon) ActParsListBegin:A1 {: RESULT=new ActParsList_Epsilon(A1); RESULT.setLine(A1left); :} /* epsilon */
			  	;
			  	
ActParsListBegin ::= (ActParsListBegin) {: RESULT=new ActParsListBegin(); :} /* epsilon */;

Condition ::= (Condition) CondTerm:C1 CondTermMore:C2 {: RESULT=new Condition(C1, C2); RESULT.setLine(C1left); :};

CondTermMore ::= (CondTermMore_Yes) LOGOR CondTerm:C1 CondTermMore:C2 {: RESULT=new CondTermMore_Yes(C1, C2); RESULT.setLine(C1left); :}
				 |
				 (CondTermMore_Epsilon) {: RESULT=new CondTermMore_Epsilon(); :} /* Epsilon */
				 ;

CondTerm ::= (CondTerm) CondFact:C1 CondFactMore:C2 {: RESULT=new CondTerm(C1, C2); RESULT.setLine(C1left); :};

CondFactMore ::= (CondFactMore_Yes) LOGAND CondFact:C1 CondFactMore:C2 {: RESULT=new CondFactMore_Yes(C1, C2); RESULT.setLine(C1left); :}
				 |
				 (CondFactMore_Epsilon) {: RESULT=new CondFactMore_Epsilon(); :} /* Epsilon */
				 ;

CondFact ::= (CondFact_1) NonTernaryExpr:N1 {: RESULT=new CondFact_1(N1); RESULT.setLine(N1left); :}
			 |
			 (CondFact_2) NonTernaryExpr:N1 Relop:R2 NonTernaryExpr:N3 {: RESULT=new CondFact_2(N1, R2, N3); RESULT.setLine(N1left); :}
			 ;

Expr ::= (Expr_NonTernary) NonTernaryExpr:N1 {: RESULT=new Expr_NonTernary(N1); RESULT.setLine(N1left); :}
		 |
		 (Expr_Ternary) Condition:C1 QUESTION Expr:E2 TernaryColon:T3 Expr:E4 {: RESULT=new Expr_Ternary(C1, E2, T3, E4); RESULT.setLine(C1left); :}
		 ;
		 
TernaryColon ::= (TernaryColon) COLON {: RESULT=new TernaryColon(); :};

NonTernaryExpr ::= (NonTernaryExpr_Regular) Term:T1 ExprAddopTerms:E2 {: RESULT=new NonTernaryExpr_Regular(T1, E2); RESULT.setLine(T1left); :}
				   |
				   (NonTernaryExpr_Minus) MINUS Term:T1 ExprAddopTerms:E2 {: RESULT=new NonTernaryExpr_Minus(T1, E2); RESULT.setLine(T1left); :}
				   ;

ExprAddopTerms ::= (ExprAddopTerms_More) Addop:A1 Term:T2 ExprAddopTerms:E3 {: RESULT=new ExprAddopTerms_More(A1, T2, E3); RESULT.setLine(A1left); :}
				   |
				   (ExprAddopTerms_Epsilon) {: RESULT=new ExprAddopTerms_Epsilon(); :} /* Epsilon */
				   ;
			   		
Term ::= (Term) Factor:F1 FactorMore:F2 {: RESULT=new Term(F1, F2); RESULT.setLine(F1left); :};

FactorMore ::= (FactorMore_Yes) Mulop:M1 Factor:F2 FactorMore:F3 {: RESULT=new FactorMore_Yes(M1, F2, F3); RESULT.setLine(M1left); :}
			   |
			   (FactorMore_Epsilon) {: RESULT=new FactorMore_Epsilon(); :} /* Epsilon */
			   ;
			   
Factor ::= (Factor_Var) Designator:D1 {: RESULT=new Factor_Var(D1); RESULT.setLine(D1left); :}
		   |
		   (Factor_Meth) Designator:D1 LPAREN ActParsList:A2 RPAREN {: RESULT=new Factor_Meth(D1, A2); RESULT.setLine(D1left); :}
		   |
		   (Factor_NumConst) NUMBER:N1 {: RESULT=new Factor_NumConst(N1); RESULT.setLine(N1left); :}
		   |
		   (Factor_CharConst) CHARACTER:C1 {: RESULT=new Factor_CharConst(C1); RESULT.setLine(C1left); :}
		   |
		   (Factor_BoolConst) BOOL:B1 {: RESULT=new Factor_BoolConst(B1); RESULT.setLine(B1left); :}
		   |
		   (Factor_New) NEW Type:T1 LSQBRACKET Expr:E2 RSQBRACKET {: RESULT=new Factor_New(T1, E2); RESULT.setLine(T1left); :}
		   |
		   (Factor_Expr) LPAREN Expr:E1 RPAREN {: RESULT=new Factor_Expr(E1); RESULT.setLine(E1left); :}
		   ;

Designator ::= (Designator_Suffix) DesignatorName:D1 DesignatorSuffix:D2 {: RESULT=new Designator_Suffix(D1, D2); RESULT.setLine(D1left); :}
			   |
			   (Designator_Regular) IDENT:I1 {: RESULT=new Designator_Regular(I1); RESULT.setLine(I1left); :}
			   ;

DesignatorSuffix ::= (Designator_Enum) DOT IDENT:I1 {: RESULT=new Designator_Enum(I1); RESULT.setLine(I1left); :}
                   	 |
                     (Designator_Length) DOT LENGTH {: RESULT=new Designator_Length(); :}
                   	 |
                   	 (Designator_Array) LSQBRACKET Expr:E1 RSQBRACKET {: RESULT=new Designator_Array(E1); RESULT.setLine(E1left); :}
                   	 ;
	   
DesignatorName ::= (DesignatorName) IDENT:I1 {: RESULT=new DesignatorName(I1); RESULT.setLine(I1left); :};
					 
Label ::= (Label) IDENT:I1 {: RESULT=new Label(I1); RESULT.setLine(I1left); :};

Assignop ::= (Assignop) ASSIGN {: RESULT=new Assignop(); :};

Relop ::= (Relop_Equal) EQUAL {: RESULT=new Relop_Equal(); :}
		  |
		  (Relop_Notequal) NOTEQUAL {: RESULT=new Relop_Notequal(); :}
		  |
		  (Relop_Greater) GREATER {: RESULT=new Relop_Greater(); :}
		  |
		  (Relop_Greaterequal) GREATEREQUAL {: RESULT=new Relop_Greaterequal(); :}
		  |
		  (Relop_Less) LESS {: RESULT=new Relop_Less(); :}
		  |
		  (Relop_Lessequal) LESSEQUAL {: RESULT=new Relop_Lessequal(); :}
		  ;
		  
Addop ::= (Addop_Plus) PLUS {: RESULT=new Addop_Plus(); :}
		  |
		  (Addop_Minus) MINUS {: RESULT=new Addop_Minus(); :}
		  ;

Mulop ::= (Mulop_Mult) MULT {: RESULT=new Mulop_Mult(); :}
		  |
		  (Mulop_Div) DIV {: RESULT=new Mulop_Div(); :}
		  |
		  (Mulop_Mod) MOD {: RESULT=new Mulop_Mod(); :}
		  ;
					 
					 
					 
					 
					 
					 				 